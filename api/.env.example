# FAMS fuel sync (automatic — fuel transactions only; does NOT update equipment hours)
# FAMS_ENABLED=true
# FAMS_BASE_URL=https://famsoldapi.azurewebsites.net/Handler1.ashx
# FAMS_CLIENT=FAMS2018
# FAMS_AUTH=your_fams_auth_secret
# FAMS_SITE_ID=305
# FAMS_POLL_MS=3600000

# Cartrack Fleet API (Mozambique) — optional; can also save in User Admin → Cartrack
# CARTRACK_BASE_URL=https://fleetapi-mz.cartrack.com/rest
# CARTRACK_USERNAME=your_cartrack_username
# CARTRACK_PASSWORD=your_api_password
# CARTRACK_MORNING_ENABLED=1
# CARTRACK_MORNING_HOUR=6
# CARTRACK_MORNING_MINUTE=0
# CARTRACK_MORNING_RECIPIENTS=supervisor@company.com,gm@company.com
# CARTRACK_SPEED_ALERT_KMH=100
# CARTRACK_FLEET_POLL_MS=300000

# CAT ISO 15143 / VisionLink bridge (optional)
# OpenAPI spec: api/scripts/cat-visionlink-openapi.yaml
# Request API access at digital.cat.com -> APIs -> ISO 15143-3
# VISIONLINK_CLIENT_ID=your_client_id
# VISIONLINK_CLIENT_SECRET=your_client_secret
# VISIONLINK_AUTH_METHOD=catFedLogin
# VISIONLINK_TOKEN_URL=https://fedlogin.cat.com/as/token.oauth2?pfidpadapterid=OAuthAdapterCCDS
# VISIONLINK_SCOPE=
# VISIONLINK_BASE_URL=https://api.cat.com/telematics/iso15143
# VISIONLINK_API_MODE=equipment
# VISIONLINK_EQUIPMENT_MAKE=CAT
# VISIONLINK_EQUIPMENT_MODEL=426-07LRC
# VISIONLINK_EQUIPMENT_SERIAL=JZ400729
# Map CAT machine serial -> IRONLOG asset_code
# VISIONLINK_ASSET_MAP_JSON={"JZ400729":"JZ400729"}
# Map CAT machine serial -> telematics device serial registered in IRONLOG
# VISIONLINK_DEVICE_MAP_JSON={"JZ400729":"23032800H0ZR0054"}
# IRONLOG_API_BASE=http://127.0.0.1:3001
# TELEMATICS_API_KEY=<same_as_server_if_required>

# SMTP / nodemailer (optional — or configure in User Admin → SMTP Mail Service)
# Zoho Mail (custom domain / organization): smtppro.zoho.com, port 587, SMTP_SECURE=0
# If your Zoho account is in EU/IN/AU, host may be smtppro.zoho.eu / .in / .com.au instead
# SMTP_HOST=smtppro.zoho.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USERNAME=reports@ironlogafrica.com
# SMTP_PASSWORD=your_zoho_password_or_app_specific_password
# SMTP_FROM_EMAIL=reports@ironlogafrica.com
# SMTP_FROM_NAME=IRONLOG Reports
# SMTP_TEST_TO=you@company.com
# IRONLOG_SMTP_SECRET=change-me-to-a-long-random-string
# SMTP_BOOTSTRAP_FORCE=1

# DB_PATH=./db/ironlog.db

# Listen address and port
# HOST=0.0.0.0
# PORT=3001

# -----------------------------------------------------------------------------
# LLM / IronMind (OpenAI-compatible chat — pick ONE backend)
# Used by IronMind Ask/Help, AI Documents, and AI Engineer planner defaults.
# Restart the API after changing these (e.g. pm2 restart).
# -----------------------------------------------------------------------------
#
# --- Option A (recommended free cloud): Groq ---
# 1) Create a key at https://console.groq.com/keys
# 2) Comment out OLLAMA_* if you were using local Ollama
# 3) Set the three lines below, then restart the API
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_your_groq_key_here
# LLM_MODEL=llama-3.3-70b-versatile
#
# Groq model picks (free tier; IDs must match Groq console exactly):
#   llama-3.3-70b-versatile              — best default for IronMind quality
#   llama-3.1-8b-instant                 — faster / higher daily request limit
#   meta-llama/llama-4-scout-17b-16e-instruct — newer Llama 4 option
#   qwen/qwen3-32b                       — strong alternative if available on your key
#
# --- Option B: local Ollama (fully free, runs on the server) ---
# OLLAMA_HOST=http://127.0.0.1:11434
# LLM_MODEL=llama3.2
# (model name must match `ollama list`; bare names get :latest appended)
#
# --- Option C: OpenAI cloud ---
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
#
# Optional aliases (same effect as OPENAI_* where noted):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# OPENAI_MODEL=llama-3.3-70b-versatile
#
# Timeouts / response budgets
# LLM_TIMEOUT_MS=45000
# IRONMIND_ASK_TIMEOUT_MS=45000
# IRONMIND_ASK_MAX_TOKENS=220
# IRONMIND_HELP_TIMEOUT_MS=35000
# IRONMIND_HELP_MAX_TOKENS=220

# When true, all /api/* calls require a valid login (Bearer token from POST /api/auth/login).
# Leave unset or false for legacy “Apply Role” header-only mode while you create passwords.
# IRONLOG_AUTH_REQUIRED=true

# Session lifetime for Bearer tokens (days)
# IRONLOG_SESSION_DAYS=14
